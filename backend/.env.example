# Backend environment variables
# Copy to .env and fill in values

PORT=5000
# Optional. Comma-separated list of allowed browser origins.
# In dev, if omitted, any http(s)://localhost:<port> is allowed (so Vite port bumps still work).
# Example:
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# CORS_ORIGIN=http://localhost:5173

# OpenAI
OPENAI_API_KEY=YOUR_REAL_OPENAI_KEY
# Optional: use an OpenAI-compatible API provider (e.g., Groq).
# If omitted, the backend will default to OpenAI, but will auto-detect Groq when the key starts with gsk_.
# Examples:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=gpt-4o-mini
